@@ -0,0 +1,96 @@
+import Foundation
+import UIKit
+
+public enum SosuzagramDesignMode: Equatable {
+    case defaultMode
+    case android
+    case material3
+}
+
+private let sosuzagramMaterial3EnabledKey = "sosuzagram_material3_enabled"
+private let sosuzagramAndroidDesignEnabledKey = "sosuzagram_android_design"
+private let sosuzagramMaterialDesignLevelKey = "sosuzagram_material_design_level"
+
+public func sosuzagramMaterial3Enabled() -> Bool {
+    return UserDefaults.standard.object(forKey: sosuzagramMaterial3EnabledKey) as? Bool ?? false
+}
+
+public func sosuzagramAndroidDesignEnabledForCurrentMode() -> Bool {
+    return !sosuzagramMaterial3Enabled() && UserDefaults.standard.bool(forKey: sosuzagramAndroidDesignEnabledKey)
+}
+
+public func sosuzagramMaterialDesignLevelForCurrentMode() -> Int {
+    guard !sosuzagramMaterial3Enabled() else {
+        return 0
+    }
+    return max(0, min(3, UserDefaults.standard.integer(forKey: sosuzagramMaterialDesignLevelKey)))
+}
+
+public func sosuzagramCurrentDesignMode() -> SosuzagramDesignMode {
+    if sosuzagramMaterial3Enabled() {
+        return .material3
+    } else if sosuzagramAndroidDesignEnabledForCurrentMode() || sosuzagramMaterialDesignLevelForCurrentMode() > 0 {
+        return .android
+    } else {
+        return .defaultMode
+    }
+}
+
+public struct SosuzagramMaterial3Metrics {
+    public let groupedCardCornerRadius: CGFloat
+    public let groupedGlassCornerRadius: CGFloat
+    public let compactCornerRadius: CGFloat
+    public let expandedCornerRadius: CGFloat
+    public let bubbleMainRadius: CGFloat
+    public let bubbleAuxiliaryRadius: CGFloat
+    
+    public init(
+        groupedCardCornerRadius: CGFloat = 18.0,
+        groupedGlassCornerRadius: CGFloat = 28.0,
+        compactCornerRadius: CGFloat = 14.0,
+        expandedCornerRadius: CGFloat = 20.0,
+        bubbleMainRadius: CGFloat = 18.0,
+        bubbleAuxiliaryRadius: CGFloat = 8.0
+    ) {
+        self.groupedCardCornerRadius = groupedCardCornerRadius
+        self.groupedGlassCornerRadius = groupedGlassCornerRadius
+        self.compactCornerRadius = compactCornerRadius
+        self.expandedCornerRadius = expandedCornerRadius
+        self.bubbleMainRadius = bubbleMainRadius
+        self.bubbleAuxiliaryRadius = bubbleAuxiliaryRadius
+    }
+}
+
+public func sosuzagramMaterial3Metrics() -> SosuzagramMaterial3Metrics {
+    return SosuzagramMaterial3Metrics()
+}
+
+public func sosuzagramMaterial3CornerRadius(for height: CGFloat, expanded: Bool = false) -> CGFloat {
+    let metrics = sosuzagramMaterial3Metrics()
+    let fallback = floor(height * 0.5)
+    guard sosuzagramMaterial3Enabled() else {
+        return fallback
+    }
+    if expanded {
+        return min(metrics.expandedCornerRadius, max(metrics.compactCornerRadius, floor(height * 0.4)))
+    } else {
+        return min(metrics.compactCornerRadius, fallback)
+    }
+}
+
+public func sosuzagramMaterial3ButtonCornerRadius(for height: CGFloat) -> CGFloat {
+    let metrics = sosuzagramMaterial3Metrics()
+    guard sosuzagramMaterial3Enabled() else {
+        return floor(height * 0.5)
+    }
+    return min(metrics.expandedCornerRadius, max(metrics.compactCornerRadius, floor(height * 0.42)))
+}
+
+public func sosuzagramMaterial3GroupedCornerRadius(glass: Bool = false) -> CGFloat {
+    let metrics = sosuzagramMaterial3Metrics()
+    if glass {
+        return sosuzagramMaterial3Enabled() ? metrics.groupedGlassCornerRadius : 26.0
+    } else {
+        return sosuzagramMaterial3Enabled() ? metrics.groupedCardCornerRadius : 11.0
+    }
+}
