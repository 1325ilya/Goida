+private func sosuzagramAvatarClipStyle(peerIsMonoforum: Bool, isForumAvatar: Bool) -> AvatarNodeClipStyle {
+    let unifiedRounding = UserDefaults.standard.bool(forKey: "sosuzagram_unified_rounding")
+    let rawValue = UserDefaults.standard.string(forKey: "sosuzagram_avatar_shape") ?? "system"
+
+    if unifiedRounding {
+        switch rawValue {
+        case "square":
+            return .none
+        case "rounded":
+            return .roundedRect
+        default:
+            return .round
+        }
+    }
+
+    switch rawValue {
+    case "square":
+        return .none
+    case "rounded":
+        return .roundedRect
+    case "circle":
+        return .round
+    default:
+        if peerIsMonoforum {
+            return .bubble
+        } else if isForumAvatar {
+            return .roundedRect
+        } else {
+            return .round
+        }
+    }
+}
