+    return sosuzagramMaterialDesignLevelForCurrentMode()
+}
+
+private func sosuzagramPillStackMode() -> String {
+    return UserDefaults.standard.string(forKey: "sosuzagram_pill_stack_mode") ?? "off"
+}
+
+private func sosuzagramFilterTabsTransitionDuration(default value: Double) -> Double {
+    return sosuzagramSmoothAnimationsEnabled() ? max(value, 0.42) : value
+}
+
+private func sosuzagramFilterBadgeSpringDuration() -> Double {
+    return sosuzagramSmoothAnimationsEnabled() ? 0.58 : 0.4
+}
+
+private func sosuzagramFilterBadgeAlphaDuration() -> Double {
+    return sosuzagramSmoothAnimationsEnabled() ? 0.34 : 0.25
+}
+
+private func sosuzagramFilterTabsTintColor(theme: PresentationTheme) -> GlassBackgroundView.TintColor {
+    if sosuzagramMaterial3Enabled() {
+        let color = theme.list.itemBlocksBackgroundColor.mixedWith(theme.list.itemAccentColor, alpha: theme.overallDarkAppearance ? 0.12 : 0.06)
+        return .init(kind: .custom(style: .default, color: color))
+    }
+    let materialDesignLevel = sosuzagramMaterialDesignLevel()
+    if materialDesignLevel > 0 {
+        let baseColor: UIColor
+        switch materialDesignLevel {
+        case 3:
+            baseColor = theme.list.itemBlocksBackgroundColor
+        case 2:
+            baseColor = theme.list.blocksBackgroundColor
+        default:
+            baseColor = theme.list.blocksBackgroundColor.withAlphaComponent(0.96)
+        }
+        if sosuzagramPillStackMode() == "stacked" {
+            return .init(kind: .custom(style: .default, color: baseColor.withAlphaComponent(0.98)))
+        }
+        return .init(kind: .custom(style: .default, color: baseColor))
+    } else if sosuzagramAndroidDesignEnabled() {
+        return .init(kind: .custom(style: .default, color: theme.list.blocksBackgroundColor))
+    } else {
+        return .init(kind: .panel)
+    }
+}
+
