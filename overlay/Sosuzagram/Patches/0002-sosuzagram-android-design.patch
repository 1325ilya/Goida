+
+private func sosuzagramFilterSelectedBackgroundImage(theme: PresentationTheme) -> UIImage? {
+    if sosuzagramMaterial3Enabled() {
+        let selectedHeight = sosuzagramFilterSelectedHeight()
+        let cornerRadius = sosuzagramMaterial3CornerRadius(for: selectedHeight, expanded: true)
+        let fillColor = theme.list.itemAccentColor.withAlphaComponent(theme.overallDarkAppearance ? 0.28 : 0.16)
+        return generateFilledRoundedRectImage(size: CGSize(width: selectedHeight, height: selectedHeight), cornerRadius: cornerRadius, color: fillColor)?.stretchableImage(withLeftCapWidth: Int(cornerRadius), topCapHeight: Int(cornerRadius))
+    }
+    let level = sosuzagramMaterialDesignLevel()
+    let selectedHeight = sosuzagramFilterSelectedHeight()
+    if level > 0 {
+        let cornerRadius = SosuzagramAndroidDesignThemeProvider.filterSelectedCornerRadius(selectedHeight: selectedHeight, pillStackMode: sosuzagramPillStackMode())
+        return generateFilledRoundedRectImage(size: CGSize(width: selectedHeight, height: selectedHeight), cornerRadius: cornerRadius, color: theme.chatList.itemHighlightedBackgroundColor)?.stretchableImage(withLeftCapWidth: Int(cornerRadius), topCapHeight: Int(cornerRadius))
+    } else {
+        if sosuzagramPillStackMode() == "off" {
+            return generateStretchableFilledCircleImage(diameter: selectedHeight, color: theme.chatList.itemHighlightedBackgroundColor)
+        } else {
+            let cornerRadius = SosuzagramAndroidDesignThemeProvider.filterSelectedCornerRadius(selectedHeight: selectedHeight, pillStackMode: sosuzagramPillStackMode())
+            return generateFilledRoundedRectImage(size: CGSize(width: selectedHeight, height: selectedHeight), cornerRadius: cornerRadius, color: theme.chatList.itemHighlightedBackgroundColor)?.stretchableImage(withLeftCapWidth: Int(cornerRadius), topCapHeight: Int(cornerRadius))
+        }
+    }
+}
 
