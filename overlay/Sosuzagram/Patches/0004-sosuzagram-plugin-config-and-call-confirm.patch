+    @objc public func formatAttributesUppercase(_ sender: Any) {
+        self.inputMenu.back()
+        self.interfaceInteraction?.updateTextInputStateAndMode { current, inputMode in
+            let nsRange = NSRange(current.selectionRange)
+            guard nsRange.location != NSNotFound, nsRange.length > 0, nsRange.location + nsRange.length <= current.inputText.length else {
+                return (current, inputMode)
+            }
+            let attributedText = NSMutableAttributedString(attributedString: current.inputText)
+            let selectedText = attributedText.attributedSubstring(from: nsRange).string
+            let transformedText = selectedText.uppercased()
+            attributedText.replaceCharacters(in: nsRange, with: transformedText)
+            var updated = current
+            updated.inputText = attributedText
+            updated.selectionRange = nsRange.location ..< (nsRange.location + transformedText.utf16.count)
+            return (updated, inputMode)
+        }
+    }
+    
