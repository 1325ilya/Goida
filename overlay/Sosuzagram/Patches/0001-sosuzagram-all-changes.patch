 import HorizontalTabsComponent
 import GlobalControlPanelsContext
 
+private func sosuzagramChatListTitleTextMode() -> String {
+    return UserDefaults.standard.string(forKey: "sosuzagram_chat_list_title_text") ?? "name"
+}
+
+private func sosuzagramFolderTabTitlesMode() -> String {
+    return UserDefaults.standard.string(forKey: "sosuzagram_folder_tab_titles") ?? "title_and_icon"
+}
+
+private func sosuzagramAccountUsername(_ peer: EnginePeer?) -> String? {
+    if let addressName = peer?.addressName, !addressName.isEmpty {
+        return addressName
+    }
+    if let username = peer?.usernames.first(where: { $0.isActive })?.username, !username.isEmpty {
+        return username
+    }
+    return nil
+}
+
+private func sosuzagramChatListHeaderTitle(defaultTitle: String, accountPeer: EnginePeer?) -> String {
+    switch sosuzagramChatListTitleTextMode() {
+    case "username":
+        if let username = sosuzagramAccountUsername(accountPeer) {
+            return "@\(username)"
+        } else {
+            return defaultTitle
+        }
+    case "name_and_username":
+        if let username = sosuzagramAccountUsername(accountPeer) {
+            return "\(defaultTitle) | @\(username)"
+        } else {
+            return defaultTitle
+        }
+    default:
+        return defaultTitle
+    }
+}
+
+private func sosuzagramFolderTabTitles(title: ChatFolderTitle, emoticon: String?) -> (title: ChatFolderTitle, shortTitle: ChatFolderTitle) {
+    let mode = sosuzagramFolderTabTitlesMode()
+    let cleanEmoticon = emoticon?.trimmingCharacters(in: .whitespacesAndNewlines)
+    
+    switch mode {
+    case "icon":
+        if let cleanEmoticon, !cleanEmoticon.isEmpty {
+            let iconTitle = ChatFolderTitle(text: cleanEmoticon, entities: [], enableAnimations: title.enableAnimations)
+            return (iconTitle, iconTitle)
+        } else {
+            return (title, title)
+        }
+    case "title_and_icon":
+        if let cleanEmoticon, !cleanEmoticon.isEmpty {
+            let fullTitle = ChatFolderTitle(text: "\(cleanEmoticon) \(title.text)", entities: [], enableAnimations: title.enableAnimations)
+            let shortTitle = ChatFolderTitle(text: cleanEmoticon, entities: [], enableAnimations: title.enableAnimations)
+            return (fullTitle, shortTitle)
+        } else {
+            return (title, title)
+        }
+    default:
+        return (title, title)
+    }
+}
