+import Foundation
+import UIKit
+
+private func sosuzagramMaterial3ForegroundColor(for color: UIColor) -> UIColor {
+    return color.lightness > 0.64 ? UIColor(white: 0.08, alpha: 0.96) : UIColor(white: 1.0, alpha: 0.96)
+}
+
+private func sosuzagramMaterial3Surface(theme: PresentationTheme, accent: UIColor, elevation: CGFloat) -> UIColor {
+    let alpha = theme.overallDarkAppearance ? min(0.22, 0.08 + elevation * 0.02) : min(0.12, 0.03 + elevation * 0.018)
+    return theme.list.blocksBackgroundColor.mixedWith(accent, alpha: alpha)
+}
+
+private func sosuzagramMaterial3PlainSurface(theme: PresentationTheme, accent: UIColor, elevation: CGFloat) -> UIColor {
+    let alpha = theme.overallDarkAppearance ? min(0.16, 0.05 + elevation * 0.015) : min(0.08, 0.02 + elevation * 0.012)
+    return theme.list.plainBackgroundColor.mixedWith(accent, alpha: alpha)
+}
+
+private func sosuzagramMaterial3Highlight(theme: PresentationTheme, accent: UIColor) -> UIColor {
+    return accent.withAlphaComponent(theme.overallDarkAppearance ? 0.22 : 0.12)
+}
+
+private func sosuzagramMaterial3Selected(theme: PresentationTheme, accent: UIColor) -> UIColor {
+    return accent.withAlphaComponent(theme.overallDarkAppearance ? 0.28 : 0.18)
+}
+
+private func sosuzagramMaterial3Separator(theme: PresentationTheme, surface: UIColor) -> UIColor {
+    return surface.mixedWith(theme.list.itemSecondaryTextColor, alpha: theme.overallDarkAppearance ? 0.22 : 0.10)
+}
+
+private func sosuzagramMaterial3VariableColor(base: PresentationThemeVariableColor, fill: UIColor) -> PresentationThemeVariableColor {
+    return base.withUpdated(withWallpaper: fill, withoutWallpaper: fill)
+}
+
+public func sosuzagramApplyMaterial3IfNeeded(to theme: PresentationTheme) -> PresentationTheme {
