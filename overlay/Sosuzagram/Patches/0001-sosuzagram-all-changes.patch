+private let sosuzagramZalgoMarks = CharacterSet.nonBaseCharacters
+private let sosuzagramDeletedMessageMarker = "\u{2063}sosuzagram_deleted_marker\u{2063}"
+private let sosuzagramLegacyDeletedMessageMarker = " \u{1F5D1}\u{FE0F}"
