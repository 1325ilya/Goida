diff --git a/submodules/TelegramUI/Sources/SosuzagramGamepadControllerSupport.swift b/submodules/TelegramUI/Sources/SosuzagramGamepadControllerSupport.swift
new file mode 100644
index 00000000..31b080e9
--- /dev/null
+++ b/submodules/TelegramUI/Sources/SosuzagramGamepadControllerSupport.swift
@@ -0,0 +1,301 @@
+import Foundation
+import GameController
+
+protocol SosuzagramGamepadEventSink: AnyObject {
+    func sosuzagramGamepadDidChangeState(_ state: SosuzagramGamepadManager.State)
+    func sosuzagramGamepadDidRequestActivationPrompt(deviceName: String)
+    func sosuzagramGamepadDidReceiveIntent(_ intent: SosuzagramGamepadIntent)
+}
+
+enum SosuzagramGamepadIntent {
+    case moveUp
+    case moveDown
+    case primaryAction
+    case back
+    case options
+}
+
+final class SosuzagramGamepadManager {
+    enum State: Equatable {
+        case disconnected
+        case connected(deviceName: String, controllerModeEnabled: Bool)
+    }
+    
+    static let shared = SosuzagramGamepadManager()
+    
+    weak var sink: SosuzagramGamepadEventSink? {
+        didSet {
+            self.notifyStateChanged()
+            self.deliverPendingPromptIfNeeded()
+        }
+    }
+    
+    private(set) var state: State = .disconnected
+    
+    private var isMonitoring = false
+    private weak var activeController: GCController?
+    private var controllerObservationTokens: [NSObjectProtocol] = []
+    private var shouldPromptForConnectedController = false
+    
+    private init() {
+    }
+    
+    var isControllerModeEnabled: Bool {
+        if case let .connected(_, controllerModeEnabled) = self.state {
+            return controllerModeEnabled
+        } else {
+            return false
+        }
+    }
+    
+    func startMonitoring() {
+        guard !self.isMonitoring else {
+            self.evaluateConnectedControllers()
+            return
+        }
+        self.isMonitoring = true
+        
+        let center = NotificationCenter.default
+        self.controllerObservationTokens.append(
+            center.addObserver(
+                forName: NSNotification.Name.GCControllerDidConnect,
+                object: nil,
+                queue: .main
+            ) { [weak self] notification in
+                self?.handleControllerConnected(notification.object as? GCController)
+            }
+        )
+        self.controllerObservationTokens.append(
+            center.addObserver(
+                forName: NSNotification.Name.GCControllerDidDisconnect,
+                object: nil,
+                queue: .main
+            ) { [weak self] notification in
+                self?.handleControllerDisconnected(notification.object as? GCController)
+            }
+        )
+        
+        self.evaluateConnectedControllers()
+    }
+    
+    func activateCurrentControllerMode() {
+        guard let controller = self.activeController ?? self.firstSupportedController() else {
+            return
+        }
+        
+        self.activeController = controller
+        self.installHandlers(for: controller)
+        self.shouldPromptForConnectedController = false
+        self.state = .connected(deviceName: self.deviceName(for: controller), controllerModeEnabled: true)
+        Logger.shared.log("SosuzagramGamepad", "controller mode enabled for \(self.deviceName(for: controller))")
+        self.notifyStateChanged()
+    }
+    
+    func declineCurrentControllerMode() {
+        guard let controller = self.activeController else {
+            return
+        }
+        self.uninstallHandlers(for: controller)
+        self.shouldPromptForConnectedController = false
+        self.state = .connected(deviceName: self.deviceName(for: controller), controllerModeEnabled: false)
+        Logger.shared.log("SosuzagramGamepad", "controller mode declined for \(self.deviceName(for: controller))")
+        self.notifyStateChanged()
+    }
+    
+    func disableControllerMode(logReason: String) {
+        if let controller = self.activeController {
+            self.uninstallHandlers(for: controller)
+        }
+        
+        switch self.state {
+        case let .connected(deviceName, _):
+            self.state = .connected(deviceName: deviceName, controllerModeEnabled: false)
+        case .disconnected:
+            break
+        }
+        
+        Logger.shared.log("SosuzagramGamepad", "controller mode disabled: \(logReason)")
+        self.notifyStateChanged()
+    }
+    
+    private func evaluateConnectedControllers() {
+        guard let controller = self.firstSupportedController() else {
+            self.handleNoSupportedControllers()
+            return
+        }
+        
+        self.activeController = controller
+        let isEnabled = self.isControllerModeEnabled
+        if isEnabled {
+            self.installHandlers(for: controller)
+        } else {
+            self.uninstallHandlers(for: controller)
+        }
+        
+        self.state = .connected(deviceName: self.deviceName(for: controller), controllerModeEnabled: isEnabled)
+        self.notifyStateChanged()
+        if !isEnabled {
+            self.shouldPromptForConnectedController = true
+            self.deliverPendingPromptIfNeeded()
+        }
+    }
+    
+    private func handleControllerConnected(_ controller: GCController?) {
+        guard let controller, self.isSupportedController(controller) else {
+            return
+        }
+        
+        self.activeController = controller
+        self.uninstallHandlers(for: controller)
+        self.state = .connected(deviceName: self.deviceName(for: controller), controllerModeEnabled: false)
+        self.shouldPromptForConnectedController = true
+        Logger.shared.log("SosuzagramGamepad", "controller connected: \(self.deviceName(for: controller))")
+        self.notifyStateChanged()
+        self.deliverPendingPromptIfNeeded()
+    }
+    
+    private func handleControllerDisconnected(_ controller: GCController?) {
+        guard let controller else {
+            self.handleNoSupportedControllers()
+            return
+        }
+        
+        let wasActiveController = self.activeController === controller
+        self.uninstallHandlers(for: controller)
+        
+        if wasActiveController {
+            Logger.shared.log("SosuzagramGamepad", "controller disconnected: \(self.deviceName(for: controller))")
+            self.activeController = nil
+            self.shouldPromptForConnectedController = false
+            self.state = .disconnected
+            self.notifyStateChanged()
+        }
+        
+        if let replacement = self.firstSupportedController() {
+            self.handleControllerConnected(replacement)
+        }
+    }
+    
+    private func handleNoSupportedControllers() {
+        if let controller = self.activeController {
+            self.uninstallHandlers(for: controller)
+        }
+        self.activeController = nil
+        self.shouldPromptForConnectedController = false
+        self.state = .disconnected
+        self.notifyStateChanged()
+    }
+    
+    private func firstSupportedController() -> GCController? {
+        return GCController.controllers().first(where: { self.isSupportedController($0) })
+    }
+    
+    private func isSupportedController(_ controller: GCController) -> Bool {
+        return controller.extendedGamepad != nil || controller.microGamepad != nil
+    }
+    
+    private func deviceName(for controller: GCController) -> String {
+        return controller.vendorName ?? "Game Controller"
+    }
+    
+    private func installHandlers(for controller: GCController) {
+        self.uninstallHandlers(for: controller)
+        
+        if let extendedGamepad = controller.extendedGamepad {
+            extendedGamepad.dpad.up.pressedChangedHandler = { [weak self] _, _, pressed in
+                guard pressed else {
+                    return
+                }
+                self?.emitIntent(.moveUp)
+            }
+            extendedGamepad.dpad.down.pressedChangedHandler = { [weak self] _, _, pressed in
+                guard pressed else {
+                    return
+                }
+                self?.emitIntent(.moveDown)
+            }
+            extendedGamepad.buttonA.pressedChangedHandler = { [weak self] _, _, pressed in
+                guard pressed else {
+                    return
+                }
+                self?.emitIntent(.primaryAction)
+            }
+            extendedGamepad.buttonB.pressedChangedHandler = { [weak self] _, _, pressed in
+                guard pressed else {
+                    return
+                }
+                self?.emitIntent(.back)
+            }
+        } else if let microGamepad = controller.microGamepad {
+            microGamepad.dpad.up.pressedChangedHandler = { [weak self] _, _, pressed in
+                guard pressed else {
+                    return
+                }
+                self?.emitIntent(.moveUp)
+            }
+            microGamepad.dpad.down.pressedChangedHandler = { [weak self] _, _, pressed in
+                guard pressed else {
+                    return
+                }
+                self?.emitIntent(.moveDown)
+            }
+            microGamepad.buttonA.pressedChangedHandler = { [weak self] _, _, pressed in
+                guard pressed else {
+                    return
+                }
+                self?.emitIntent(.primaryAction)
+            }
+            microGamepad.buttonX.pressedChangedHandler = { [weak self] _, _, pressed in
+                guard pressed else {
+                    return
+                }
+                self?.emitIntent(.back)
+            }
+        }
+        
+        controller.controllerPausedHandler = { [weak self] _ in
+            self?.emitIntent(.options)
+        }
+    }
+    
+    private func uninstallHandlers(for controller: GCController) {
+        controller.controllerPausedHandler = nil
+        
+        if let extendedGamepad = controller.extendedGamepad {
+            extendedGamepad.dpad.up.pressedChangedHandler = nil
+            extendedGamepad.dpad.down.pressedChangedHandler = nil
+            extendedGamepad.buttonA.pressedChangedHandler = nil
+            extendedGamepad.buttonB.pressedChangedHandler = nil
+        }
+        
+        if let microGamepad = controller.microGamepad {
+            microGamepad.dpad.up.pressedChangedHandler = nil
+            microGamepad.dpad.down.pressedChangedHandler = nil
+            microGamepad.buttonA.pressedChangedHandler = nil
+            microGamepad.buttonX.pressedChangedHandler = nil
+        }
+    }
+    
+    private func emitIntent(_ intent: SosuzagramGamepadIntent) {
+        guard self.isControllerModeEnabled else {
+            return
+        }
+        DispatchQueue.main.async { [weak self] in
+            self?.sink?.sosuzagramGamepadDidReceiveIntent(intent)
+        }
+    }
+    
+    private func notifyStateChanged() {
+        self.sink?.sosuzagramGamepadDidChangeState(self.state)
+    }
+    
+    private func deliverPendingPromptIfNeeded() {
+        guard self.shouldPromptForConnectedController else {
+            return
+        }
+        guard case let .connected(deviceName, controllerModeEnabled) = self.state, !controllerModeEnabled else {
+            return
+        }
+        self.sink?.sosuzagramGamepadDidRequestActivationPrompt(deviceName: deviceName)
+    }
+}
