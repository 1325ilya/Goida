+private func sosuzagramFilterPeerTitleIfNeeded(_ text: String) -> String {
+    guard UserDefaults.standard.bool(forKey: "sosuzagram_filter_zalgo"), !text.isEmpty else {
+        return text
+    }
+    
+    var filtered = String.UnicodeScalarView()
+    filtered.reserveCapacity(text.unicodeScalars.count)
+    
+    for scalar in text.unicodeScalars {
+        if !sosuzagramPeerTitleZalgoMarks.contains(scalar) {
+            filtered.append(scalar)
+        }
+    }
+    
+    return String(filtered)
+}
