+private func sosuzagramRelativeOnlineTime() -> Bool {
+    return UserDefaults.standard.bool(forKey: "sosuzagram_relative_online_time")
+}
+
+private func sosuzagramPreciseLastSeenString(strings: PresentationStrings, dateTimeFormat: PresentationDateTimeFormat, timestamp: Int32, relativeTo currentTimestamp: Int32) -> String {
+    var t: time_t = time_t(timestamp)
+    var timeinfo: tm = tm()
+    localtime_r(&t, &timeinfo)
+    
+    let timeString = stringForShortTimestamp(hours: timeinfo.tm_hour, minutes: timeinfo.tm_min, dateTimeFormat: dateTimeFormat)
+    
+    var now: time_t = time_t(currentTimestamp)
+    var timeinfoNow: tm = tm()
+    localtime_r(&now, &timeinfoNow)
+    
+    if timeinfo.tm_year != timeinfoNow.tm_year {
+        let dateString = stringForTimestamp(day: timeinfo.tm_mday, month: timeinfo.tm_mon + 1, year: timeinfo.tm_year, dateTimeFormat: dateTimeFormat)
+        return strings.LastSeen_AtDate("\(dateString), \(timeString)").string
+    }
+    
+    let dayDifference = timeinfo.tm_yday - timeinfoNow.tm_yday
+    if dayDifference == 0 {
+        return strings.LastSeen_TodayAt(timeString).string
+    } else if dayDifference == -1 {
+        return strings.LastSeen_YesterdayAt(timeString).string
+    } else {
+        let dateString = stringForTimestamp(day: timeinfo.tm_mday, month: timeinfo.tm_mon + 1, year: timeinfo.tm_year, dateTimeFormat: dateTimeFormat)
+        return strings.LastSeen_AtDate("\(dateString), \(timeString)").string
+    }
+}
+
+private func sosuzagramPresenceText(strings: PresentationStrings, dateTimeFormat: PresentationDateTimeFormat, presence: TelegramUserPresence, relativeTo timestamp: Int32) -> (String, Bool) {
+    if !sosuzagramRelativeOnlineTime() {
+        return stringAndActivityForUserPresence(strings: strings, dateTimeFormat: dateTimeFormat, presence: EnginePeer.Presence(presence), relativeTo: timestamp, expanded: true)
+    }
+    
+    switch presence.status {
+    case let .present(statusTimestamp):
+        if statusTimestamp >= timestamp {
+            return (strings.Presence_online, true)
+        } else {
+            return (sosuzagramPreciseLastSeenString(strings: strings, dateTimeFormat: dateTimeFormat, timestamp: statusTimestamp, relativeTo: timestamp), false)
+        }
+    case .none, .recently, .lastWeek, .lastMonth:
+        if presence.lastActivity > 0 {
+            return (sosuzagramPreciseLastSeenString(strings: strings, dateTimeFormat: dateTimeFormat, timestamp: presence.lastActivity, relativeTo: timestamp), false)
+        } else {
+            return stringAndActivityForUserPresence(strings: strings, dateTimeFormat: dateTimeFormat, presence: EnginePeer.Presence(presence), relativeTo: timestamp, expanded: true)
+        }
+    }
+}
