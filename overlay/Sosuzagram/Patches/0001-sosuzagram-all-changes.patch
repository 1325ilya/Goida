+
+public func sosuzagramFilterZalgoIfNeeded(_ text: String) -> String {
+    guard sosuzagramFilterZalgoEnabled(), !text.isEmpty else {
+        return text
+    }
+    
+    var filtered = String.UnicodeScalarView()
+    filtered.reserveCapacity(text.unicodeScalars.count)
+    
+    for scalar in text.unicodeScalars {
+        if !sosuzagramZalgoMarks.contains(scalar) {
+            filtered.append(scalar)
+        }
+    }
+    
+    return String(filtered)
+}
+
+public func sosuzagramFilterZalgoIfNeeded(text: String, entities: [MessageTextEntity]) -> (String, [MessageTextEntity]) {
+    guard sosuzagramFilterZalgoEnabled(), !text.isEmpty else {
+        return (text, entities)
+    }
+    
+    var filtered = String.UnicodeScalarView()
+    filtered.reserveCapacity(text.unicodeScalars.count)
+    
+    var offsetMap: [Int: Int] = [0: 0]
+    var originalOffset = 0
+    var filteredOffset = 0
+    
+    for scalar in text.unicodeScalars {
+        let scalarLength = scalar.utf16.count
+        offsetMap[originalOffset] = filteredOffset
+        
+        if !sosuzagramZalgoMarks.contains(scalar) {
+            filtered.append(scalar)
+            filteredOffset += scalarLength
+        }
+        
+        originalOffset += scalarLength
+        offsetMap[originalOffset] = filteredOffset
+    }
+    
