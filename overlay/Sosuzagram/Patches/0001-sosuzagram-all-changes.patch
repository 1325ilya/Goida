+    case "large":
+        return 1.15
+    default:
+        return 1.0
+    }
+}
+
+private func sosuzagramScaledStickerSize(_ base: CGSize) -> CGSize {
+    let scale = sosuzagramStickerSizeScale()
+    return CGSize(width: floor(base.width * scale), height: floor(base.height * scale))
+}
