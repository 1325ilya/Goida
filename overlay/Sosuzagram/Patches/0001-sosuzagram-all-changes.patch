+            actionButtonsStrokeColor: sosuzagramMaterial3VariableColor(base: theme.chat.message.incoming.actionButtonsStrokeColor, fill: accent.withAlphaComponent(theme.overallDarkAppearance ? 0.28 : 0.14)),
+            actionButtonsTextColor: sosuzagramMaterial3VariableColor(base: theme.chat.message.incoming.actionButtonsTextColor, fill: accent),
+            textSelectionColor: highlight
+        ),
+        outgoing: theme.chat.message.outgoing.withUpdated(
