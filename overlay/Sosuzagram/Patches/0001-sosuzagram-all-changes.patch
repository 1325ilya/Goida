+        ),
+        controlSecondaryColor: accent.withAlphaComponent(theme.overallDarkAppearance ? 0.72 : 0.64),
+        freeInputField: theme.list.freeInputField.withUpdated(
+            backgroundColor: searchField,
+            strokeColor: separator,
+            placeholderColor: theme.list.itemSecondaryTextColor.withAlphaComponent(0.8),
+            controlColor: accent.withAlphaComponent(0.7)
+        ),
+        freePlainInputField: theme.list.freePlainInputField.withUpdated(
+            backgroundColor: searchField,
+            strokeColor: separator,
+            placeholderColor: theme.list.itemSecondaryTextColor.withAlphaComponent(0.8),
+            controlColor: accent.withAlphaComponent(0.7)
+        ),
+        itemInputField: theme.list.itemInputField.withUpdated(
+            backgroundColor: searchField,
+            strokeColor: separator,
+            placeholderColor: theme.list.itemSecondaryTextColor.withAlphaComponent(0.82),
+            controlColor: accent.withAlphaComponent(0.7)
+        )
+    )
+    
+    let rootController = theme.rootController.withUpdated(
+        tabBar: theme.rootController.tabBar.withUpdated(
+            backgroundColor: surface2,
+            separatorColor: separator,
+            selectedIconColor: accent,
+            selectedTextColor: accent
+        ),
+        navigationBar: theme.rootController.navigationBar.withUpdated(
+            buttonColor: accent,
+            accentTextColor: accent,
+            blurredBackgroundColor: surface1.withAlphaComponent(theme.overallDarkAppearance ? 0.92 : 0.96),
+            opaqueBackgroundColor: surface1,
+            separatorColor: separator,
+            segmentedBackgroundColor: surface3,
+            segmentedForegroundColor: accentContainer,
+            segmentedTextColor: theme.rootController.navigationBar.primaryTextColor,
+            segmentedDividerColor: separator
+        ),
+        navigationSearchBar: theme.rootController.navigationSearchBar.withUpdated(
+            backgroundColor: surface1,
+            accentColor: accent,
+            inputFillColor: searchField,
+            separatorColor: separator
+        )
+    )
+    
+    let chatList = theme.chatList.withUpdated(
+        backgroundColor: surface0,
+        itemSeparatorColor: separator,
+        itemBackgroundColor: surface1,
+        pinnedItemBackgroundColor: surface2,
+        itemHighlightedBackgroundColor: highlight,
+        pinnedItemHighlightedBackgroundColor: highlight,
+        itemSelectedBackgroundColor: selected,
+        checkmarkColor: accent,
+        unreadBadgeActiveBackgroundColor: accent,
+        unreadBadgeActiveTextColor: onAccent,
+        unreadBadgeInactiveBackgroundColor: accent.withAlphaComponent(theme.overallDarkAppearance ? 0.26 : 0.12),
+        unreadBadgeInactiveTextColor: accent,
