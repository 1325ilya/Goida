+private func sosuzagramStatusIconString(image: UIImage?, color: UIColor, font: UIFont) -> NSAttributedString? {
+    guard let image, let tintedImage = generateTintedImage(image: image, color: color) else {
+        return nil
+    }
+    let attachment = NSTextAttachment()
+    attachment.image = tintedImage
+    let iconHeight = max(10.0, font.pointSize - 1.0)
+    let scale = tintedImage.size.height > 0.0 ? iconHeight / tintedImage.size.height : 1.0
+    let iconWidth = max(10.0, tintedImage.size.width * scale)
+    attachment.bounds = CGRect(x: 0.0, y: floor((font.capHeight - iconHeight) / 2.0) - 1.0, width: iconWidth, height: iconHeight)
+    return NSAttributedString(attachment: attachment)
+}
