+    return UserDefaults.standard.bool(forKey: "sosuzagram_hide_reactions")
+}
+
+private func sosuzagramPerformDoubleTapAction(item: ChatMessageItem, message: Message) -> Bool {
+    let incoming = message.effectivelyIncoming(item.context.account.peerId)
+    switch sosuzagramDoubleTapAction(incoming: incoming) {
+    case .reactions:
+        guard !sosuzagramHideReactions(), canAddMessageReactions(message: message) else {
+            return false
+        }
+        item.controllerInteraction.updateMessageReaction(message, .default, false, nil)
+        return true
+    case .none:
+        return true
+    }
+}
+
+private func sosuzagramStickerSizeScale() -> CGFloat {
+    switch UserDefaults.standard.string(forKey: "sosuzagram_sticker_size_preset") ?? "medium" {
+    case "small":
+        return 0.85
+    case "large":
+        return 1.15
+    default:
+        return 1.0
+    }
+}
+
+private func sosuzagramScaledStickerSize(_ base: CGSize) -> CGSize {
+    let scale = sosuzagramStickerSizeScale()
+    return CGSize(width: floor(base.width * scale), height: floor(base.height * scale))
+}
+
+private func sosuzagramStickerShape() -> String {
+    return UserDefaults.standard.string(forKey: "sosuzagram_sticker_shape") ?? "default"
+}
+
+private func sosuzagramStickerBackgroundFrame(imageFrame: CGRect, shape: String) -> CGRect {
+    switch shape {
+    case "rounded":
+        return imageFrame.insetBy(dx: -10.0, dy: -10.0)
+    case "message":
+        return imageFrame.insetBy(dx: -12.0, dy: -12.0)
+    default:
+        return imageFrame
+    }
+}
+
+private func sosuzagramStickerBackgroundCornerRadius(shape: String) -> CGFloat {
+    switch shape {
+    case "rounded":
+        return 24.0
+    case "message":
+        return 18.0
+    default:
+        return 0.0
+    }
+}
