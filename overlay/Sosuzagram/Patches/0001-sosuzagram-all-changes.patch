+    let surface1 = sosuzagramMaterial3Surface(theme: theme, accent: accent, elevation: 1.0)
+    let surface2 = sosuzagramMaterial3Surface(theme: theme, accent: accent, elevation: 2.0)
+    let surface3 = sosuzagramMaterial3Surface(theme: theme, accent: accent, elevation: 3.0)
+    let separator = sosuzagramMaterial3Separator(theme: theme, surface: surface2)
+    let highlight = sosuzagramMaterial3Highlight(theme: theme, accent: accent)
+    let selected = sosuzagramMaterial3Selected(theme: theme, accent: accent)
+    let accentContainer = accent.withAlphaComponent(theme.overallDarkAppearance ? 0.34 : 0.18)
+    let searchField = surface3.mixedWith(theme.list.itemPrimaryTextColor, alpha: theme.overallDarkAppearance ? 0.04 : 0.015)
+    
+    let list = theme.list.withUpdated(
+        blocksBackgroundColor: surface1,
+        modalBlocksBackgroundColor: surface2,
+        plainBackgroundColor: surface0,
+        modalPlainBackgroundColor: surface1,
+        itemHighlightedColor: selected,
+        itemBlocksBackgroundColor: surface2,
+        itemModalBlocksBackgroundColor: surface3,
+        itemHighlightedBackgroundColor: highlight,
+        itemBlocksSeparatorColor: separator,
+        itemPlainSeparatorColor: separator.withAlphaComponent(theme.overallDarkAppearance ? 0.8 : 0.7),
+        sectionHeaderTextColor: theme.list.sectionHeaderTextColor.mixedWith(accent, alpha: theme.overallDarkAppearance ? 0.12 : 0.08),
+        itemSwitchColors: theme.list.itemSwitchColors.withUpdated(
+            frameColor: separator.withAlphaComponent(0.9),
+            handleColor: sosuzagramMaterial3ForegroundColor(for: surface3),
+            contentColor: onAccent,
+            positiveColor: accent,
+            negativeColor: separator.withAlphaComponent(theme.overallDarkAppearance ? 1.0 : 0.9)
