+private enum SosuzagramMessageMenuItem: String {
+    case reply
+    case copy
+    case translate
+    case speak
+    case save
+    case forward
+    case select
+    case delete
+    case admin
+
+    var defaultsKey: String {
+        return "sosuzagram_message_menu_option_\(self.rawValue)"
+    }
+
+    var actionId: String {
+        return "sosuzagram.messageMenu.\(self.rawValue)"
+    }
+
+    var defaultValue: Bool {
+        switch self {
+        case .speak:
+            return false
+        default:
+            return true
+        }
+    }
+}
+
+private func sosuzagramMessageMenuCustomizationEnabled() -> Bool {
+    return UserDefaults.standard.bool(forKey: "sosuzagram_message_menu_enabled")
+}
+
+private func sosuzagramMessageMenuItemEnabled(_ item: SosuzagramMessageMenuItem) -> Bool {
+    if item == .admin {
+        return UserDefaults.standard.bool(forKey: "sosuzagram_quick_admin_actions")
+    }
+    guard sosuzagramMessageMenuCustomizationEnabled() else {
+        return true
+    }
+    let defaults = UserDefaults.standard
+    if defaults.object(forKey: item.defaultsKey) == nil {
+        return item.defaultValue
+    }
+    return defaults.bool(forKey: item.defaultsKey)
+}
+
+private func sosuzagramShouldGroupMessageMenu() -> Bool {
+    return UserDefaults.standard.bool(forKey: "sosuzagram_group_message_menu")
+}
+
+private func sosuzagramNormalizedContextMenuItems(_ items: [ContextMenuItem]) -> [ContextMenuItem] {
+    var normalized: [ContextMenuItem] = []
+    var previousWasSeparator = true
+    for item in items {
+        switch item {
+        case .separator:
+            if !previousWasSeparator {
+                normalized.append(.separator)
+                previousWasSeparator = true
+            }
+        default:
+            normalized.append(item)
+            previousWasSeparator = false
+        }
+    }
+    while case .separator? = normalized.last {
+        normalized.removeLast()
+    }
+    return normalized
+}
+
+private func sosuzagramGroupedContextMenuItems(_ items: [ContextMenuItem]) -> [ContextMenuItem] {
+    guard sosuzagramShouldGroupMessageMenu() else {
+        return items
+    }
+    var grouped: [ContextMenuItem] = []
+    var remaining: [ContextMenuItem] = []
+
+    for item in items {
+        if case let .action(actionItem) = item, let id = actionItem.id as? String, id.hasPrefix("sosuzagram.messageMenu.") {
+            grouped.append(item)
+        } else {
+            remaining.append(item)
+        }
+    }
+
+    grouped = sosuzagramNormalizedContextMenuItems(grouped)
+    remaining = sosuzagramNormalizedContextMenuItems(remaining)
+    guard !grouped.isEmpty else {
+        return remaining
+    }
+
+    if !remaining.isEmpty {
+        remaining.append(.separator)
+    }
+    remaining.append(contentsOf: grouped)
+    return sosuzagramNormalizedContextMenuItems(remaining)
+}
