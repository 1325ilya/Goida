+    private func sosuzagramResolvedVisiblePeerEntries() -> [(index: EngineChatList.Item.Index, peer: EnginePeer, entryIndex: Int)] {
+        guard let chatListView = (self.opaqueTransactionState as? ChatListOpaqueTransactionState)?.chatListView else {
+            return []
+        }
+        
+        let entryCount = chatListView.filteredEntries.count
+        guard entryCount > 0 else {
+            return []
+        }
+        
+        guard let range = self.displayedItemRange.visibleRange ?? self.displayedItemRange.loadedRange else {
+            return []
+        }
+        
+        var result: [(index: EngineChatList.Item.Index, peer: EnginePeer, entryIndex: Int)] = []
+        for i in range.firstIndex ..< range.lastIndex {
+            if i < 0 || i >= entryCount {
+                continue
+            }
+            
+            let entryIndex = entryCount - i - 1
+            if entryIndex < 0 || entryIndex >= entryCount {
+                continue
+            }
+            
+            if case let .PeerEntry(peerEntry) = chatListView.filteredEntries[entryIndex], let peer = peerEntry.peer.peer {
+                result.append((peerEntry.index, peer, entryIndex))
+            }
+        }
+        return result
+    }
+    
+    private func sosuzagramResolvedHighlightedPeerEntry() -> (index: EngineChatList.Item.Index, peer: EnginePeer, entryIndex: Int)? {
+        guard let interaction = self.interaction else {
+            return nil
+        }
+        
+        guard let chatListView = (self.opaqueTransactionState as? ChatListOpaqueTransactionState)?.chatListView else {
+            return nil
+        }
+        
+        guard let highlightedLocation = interaction.highlightedChatLocation?.location else {
+            return nil
+        }
+        
+        for (entryIndex, entry) in chatListView.filteredEntries.enumerated() {
+            guard case let .PeerEntry(peerEntry) = entry, let peer = peerEntry.peer.peer else {
+                continue
+            }
+            if highlightedLocation == ChatLocation.peer(id: peer.id) {
+                return (peerEntry.index, peer, entryIndex)
+            }
+        }
+        
+        return nil
+    }
+    
+    private func sosuzagramApplyGamepadHighlight(
+        index: EngineChatList.Item.Index,
+        peer: EnginePeer,
+        sourceIndex: EngineChatList.Item.Index?
+    ) {
+        let location: ChatListNodeLocation = .scroll(
+            index: index,
+            sourceIndex: sourceIndex ?? .chatList(.absoluteLowerBound),
+            scrollPosition: .center(.top),
+            animated: true,
+            filter: self.chatListFilter
+        )
+        self.setChatListLocation(location)
+        self.updateSelectedChatLocation(.peer(id: peer.id), progress: 1.0, transition: .immediate)
+    }
+    
+    public func sosuzagramEnsureGamepadSelection() -> Bool {
+        if self.sosuzagramResolvedHighlightedPeerEntry() != nil {
+            return true
+        }
+        
+        guard let target = self.sosuzagramResolvedVisiblePeerEntries().first else {
+            return false
+        }
+        
+        self.sosuzagramApplyGamepadHighlight(
+            index: target.index,
+            peer: target.peer,
+            sourceIndex: self.currentlyVisibleLatestChatListIndex()
+        )
+        return true
+    }
+    
+    public func sosuzagramMoveGamepadSelection(isMovingUp: Bool) -> Bool {
+        guard let chatListView = (self.opaqueTransactionState as? ChatListOpaqueTransactionState)?.chatListView else {
+            return false
+        }
+        
+        let entryCount = chatListView.filteredEntries.count
+        guard entryCount > 0 else {
+            return false
+        }
+        
+        let sourceIndex = self.currentlyVisibleLatestChatListIndex()
+        
+        if let current = self.sosuzagramResolvedHighlightedPeerEntry() {
+            let step = isMovingUp ? 1 : -1
+            var candidateEntryIndex = current.entryIndex + step
+            
+            while candidateEntryIndex >= 0 && candidateEntryIndex < entryCount {
+                if case let .PeerEntry(peerEntry) = chatListView.filteredEntries[candidateEntryIndex], let peer = peerEntry.peer.peer {
+                    self.sosuzagramApplyGamepadHighlight(index: peerEntry.index, peer: peer, sourceIndex: sourceIndex)
+                    return true
+                }
+                candidateEntryIndex += step
+            }
