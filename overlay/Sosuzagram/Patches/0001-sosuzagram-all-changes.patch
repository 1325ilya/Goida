+private func sosuzagramActualTimestamp(status: MediaPlayerStatus) -> Double {
+    var timestamp = status.timestamp
+    switch status.status {
+    case .playing:
+        timestamp += max(0.0, CACurrentMediaTime() - status.generationTimestamp) * status.baseRate
+    default:
+        break
+    }
+    return min(max(0.0, timestamp), status.duration)
+}
