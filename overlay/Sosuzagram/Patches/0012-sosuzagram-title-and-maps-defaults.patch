+private func sosuzagramPreferredLocationIdentifiers(directions: OpenInLocationDirections?) -> [String] {
+    if directions != nil {
+        return ["yandexMaps", "yangoMaps", "yandexNavi"]
+    } else {
+        return ["yandexMaps", "yangoMaps"]
+    }
+}
+
 public func availableOpenInOptions(context: AccountContext, item: OpenInItem) -> [OpenInOption] {
-    return allOpenInOptions(context: context, item: item).filter { option in
+    var options = allOpenInOptions(context: context, item: item).filter { option in
         if case let .other(_, _, scheme, _) = option.application {
             return context.sharedContext.applicationBindings.canOpenUrl("\(scheme)://")
         } else {
             return true
         }
     }
+    if UserDefaults.standard.bool(forKey: "sosuzagram_use_yandex_maps"), case let .location(_, directions) = item {
+        let preferredIdentifiers = sosuzagramPreferredLocationIdentifiers(directions: directions)
+        let preferredSet = Set(preferredIdentifiers)
+        let preferredOptions = preferredIdentifiers.compactMap { identifier in
+            options.first(where: { $0.identifier == identifier })
+        }
+        let remainingOptions = options.filter { !preferredSet.contains($0.identifier) }
+        options = preferredOptions + remainingOptions
+    }
+    return options
 }
 
